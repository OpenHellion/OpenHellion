<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<AssemblyName>OpenHellion.State</AssemblyName>
		<RootNamespace>OpenHellion.State</RootNamespace>
		<TargetFramework>netstandard2.1</TargetFramework>
		<LangVersion>9</LangVersion>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<DebugType>portable</DebugType>
		<UnityPluginDirectory>$(MSBuildThisFileDirectory)..\..\..\Client\Assets\Plugins\OpenHellion.State\</UnityPluginDirectory>
	</PropertyGroup>
	<Target Name="CopyToUnityClient" AfterTargets="Build">
		<Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(UnityPluginDirectory)" SkipUnchangedFiles="true" />
	</Target>
</Project>
