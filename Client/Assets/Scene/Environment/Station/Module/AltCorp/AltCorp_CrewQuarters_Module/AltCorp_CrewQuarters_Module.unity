MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1795}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 9
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 1
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "...good God, this is a slaughterhouse\u2026\n\n\n(gunfire)\nVoice 1: This
    is checkpoint 2, we\u2019re under attack\u2026(static) Deadwolf\u2019s Lancers
    (static)... can\u2019t hold th\u2026 Arrgghhh!\nVoice 2: Fall back! Fall ba...\n\n\nThis
    was a full military OP, not an inside job\u2026 Sons blew the airlock and stormed
    the checkpoint\u2026 AltCorp security fought, but couldn\u2019t hold them back\u2026
    Whoever this Deadwolf is, he\u2019s ruthless, insane and\u2026 it hurts me to
    say... efficient... \n\n\nThis is not how I remember Sons operated, this does
    not look like a terrorist attack at all\u2026 What were they looking for? Let
    me dig up the logs...\n\n\nThere we go,  Arthur Williams, senior engineer 1st
    class, up for transfer... but doesn\u2019t say to where\u2026  I need to find
    out. \n\n\nIf my codes still work I can probably use the SDS outpost near Broken
    Marble to run a security check...\n"
